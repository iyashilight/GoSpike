# 复制为 .env 后按需修改：cp .env.example .env
# .env 已被 .gitignore 忽略，不会提交到仓库

# MySQL root 密码（docker-compose 与各服务的 MYSQL_DSN 都会用到）
MYSQL_ROOT_PASSWORD=change-me-mysql-root-password

# JWT 签名密钥，请换成足够随机的长字符串
JWT_SECRET=change-me-to-a-random-jwt-secret

# RabbitMQ 账号（默认 guest/guest，仅适合本地开发）
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
